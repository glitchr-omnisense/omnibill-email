{
    "name": "omnibill/email",
    "type": "library",
    "description": "Omnibill E-mail: the invoice attached to an e-mail sent through symfony/mailer, its statuses (sent, paid, refused...) kept by hand in a store of the application's - the default gateway of omniscient/omnibill, and the tests'; no platform, no approval.",
    "keywords": [
        "invoice",
        "e-invoicing",
        "email",
        "mailer",
        "omnibill"
    ],
    "homepage": "https://github.com/glitchr-studio/omnibill-email",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omniscient/omnibill": "^1.0@dev",
        "symfony/mailer": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnibill\\Email\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnibill\\Email\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
